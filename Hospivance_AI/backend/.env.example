# Copy this file to `.env` in the project root AND/OR `backend/.env`.
# The backend loads both. Never put secrets in the frontend.

# --- Database ---
# Preferred (PostgreSQL). Example matches docker-compose.yml
DATABASE_URL=postgresql+psycopg2://hospivance:hospivance@localhost:5432/hospivance
# Local fallback if Postgres is not running (automatic in code if Postgres fails):
# DATABASE_URL=sqlite:///./data/hospivance.db

# --- App ---
APP_NAME=Hospivance AI
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SIMULATE_REALTIME=true

# --- Generative AI (backend only) ---
# Leave empty to use the rule-based recommendation fallback.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Hackathon organizer / external hospital API ---
# If organizers give you a REST API, put it here. Do not put the key in React code.
ORGANIZER_API_BASE_URL=
ORGANIZER_API_KEY=
ORGANIZER_API_AUTH_HEADER=Authorization
ORGANIZER_API_AUTH_SCHEME=Bearer
# Optional path overrides (relative to ORGANIZER_API_BASE_URL)
ORGANIZER_PATH_ADMISSIONS=/admissions
ORGANIZER_PATH_BEDS=/beds
ORGANIZER_PATH_DEPARTMENTS=/departments
